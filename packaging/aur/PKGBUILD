optdepends=('chromium: sign in to the web chats (Google Chrome works too)')
provides=('switchyard')
conflicts=('switchyard')
options=('!strip' '!debug')
source_x86_64=("switchyard-${pkgver}-linux-x64.tar.gz::${url}/releases/download/v${pkgver}/switchyard-${pkgver}-linux-x64.tar.gz")
source_aarch64=("switchyard-${pkgver}-linux-arm64.tar.gz::${url}/releases/download/v${pkgver}/switchyard-${pkgver}-linux-arm64.tar.gz")

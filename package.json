{
    "name": "switchyard",
    "version": "2.10.0",
    "description": "Local OpenAI-compatible gateway for web AI chats and free model APIs",
    "author": "kravchenski",
    "license": "MIT",
    "homepage": "https://github.com/kravchenski/switchyard#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kravchenski/switchyard.git"
    },
    "bugs": {
        "url": "https://github.com/kravchenski/switchyard/issues"
    },
    "main": "src/unified/server.ts",
    "type": "module",
    "packageManager": "bun@1.4.2",
    "engines": {
        "bun": ">=1.2.0"
    },
    "scripts": {
        "start": "bun run src/unified/server.ts",
        "start:unified": "bun run src/unified/server.ts",
        "start:deepseek": "bun run src/providers/deepseek/server.ts",
        "start:full": "bun run scripts/start.ts",
        "start:deepseek:full": "bun run scripts/start.ts --service deepseek",
        "dev": "bun --watch src/unified/server.ts",
        "dev:unified": "bun --watch src/unified/server.ts",
        "dev:deepseek": "bun --watch src/providers/deepseek/server.ts",
        "test": "bun test ./test",
        "audit": "bun audit --production",
        "analyze": "knip --reporter compact",
        "check": "bun build src/providers/deepseek/server.ts src/unified/server.ts src/web/server.ts --target=bun --external typescript --external 'chromium-bidi/*' --outdir=.build-check --entry-naming '[name].[hash].[ext]'",
        "typecheck": "tsc --noEmit -p .",
        "ci": "bun run check && bun run typecheck && bun run test",
        "check:no-js": "bun run scripts/check-no-js.ts",
        "example:stream": "bun run examples/openai-sdk/streaming.ts",
        "example:simple": "bun run examples/openai-sdk/simple.ts",
        "example:system": "bun run examples/openai-sdk/system-message.ts",
        "example:image": "bun run examples/openai-sdk/image-analysis.ts",
        "example:conversation": "bun run examples/openai-sdk/conversation.ts",
        "example:compatibility": "bun run examples/openai-sdk/openai-compatibility.ts",
        "example:direct": "bun run examples/direct-api/fetch-example.ts",
        "example:ofetch": "bun run examples/direct-api/ofetch-example.ts",
        "example:streaming-test": "bun run examples/streaming-test.ts",
        "auth:deepseek": "bun run scripts/deepseek-auth.ts",
        "account": "bun run scripts/accounts.ts",
        "desktop": "cargo run --manifest-path desktop/Cargo.toml",
        "desktop:test": "cargo test --manifest-path desktop/Cargo.toml",
        "setup:agents": "bun run scripts/setup-agents.ts",
        "setup:pi": "bun run scripts/setup-pi.ts",
        "smoke": "bun run scripts/smoke_test.ts",
        "models:probe": "bun run scripts/probe-models.ts",
        "web": "bun run src/web/server.ts",
        "web:dev": "bun --watch src/web/server.ts"
    },
    "dependencies": {
        "hono": "^4.12.26",
        "ofetch": "^1.4.0",
        "playwright-core": "^1.63.0",
        "yaml": "^2.9.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/bun": "^1.4.2",
        "knip": "^6.16.1",
        "openai": "^4.104.0",
        "typescript": "^7.0.2"
    }
}

# Optional API fallback providers with free tiers. Leave a key empty to skip the provider,
# or save it encrypted instead: bun run account add <provider> --api-key
# Every *_API_KEY takes one key or several, like the desktop app's saved keys:
#   GROQ_API_KEY=gsk_first,gsk_second,gsk_third
#   GROQ_API_KEY=["gsk_first","gsk_second"]
# Keys from here and saved keys are combined. The gateway sticks to the key that works and
# moves on to the next one in the same request when a key is rate limited (paused ~1 min or
# per Retry-After), out of quota or rejected (paused 1 h).
# Cloudflare entries are <account id>:<token>, or one token per entry with CLOUDFLARE_ACCOUNT_ID.
# Keys: build.nvidia.com, openrouter.ai/keys (only :free models are used), console.groq.com/keys,
# aistudio.google.com/apikey, cloud.cerebras.ai, console.mistral.ai/api-keys, cloud.sambanova.ai/apis,
# github.com/settings/personal-access-tokens (models:read), huggingface.co/settings/tokens,
# open.bigmodel.cn/usercenter/apikeys (free flash models), dashboard.cohere.com/api-keys,
# aionlabs.ai/app/api-keys, token.llm7.io, z.ai/manage-apikey/apikey-list (free flash models),
# ollama.com/settings/keys, opencode.ai/auth (free Zen models), app.kilo.ai/profile.
# OVHcloud AI Endpoints and Kilo Gateway also work without a key.
# Cloudflare Workers AI: an API token with Workers AI access (dash.cloudflare.com/profile/api-tokens)
# and the Account ID from the dashboard.
# xKiro (third-party gateway, free models only; off in model=auto until you enable it): xkiro.com/dashboard/keys
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
SAMBANOVA_API_KEY=
GITHUB_MODELS_API_KEY=
HUGGINGFACE_API_KEY=
BIGMODEL_API_KEY=
COHERE_API_KEY=
AION_API_KEY=
OVHCLOUD_API_KEY=
LLM7_API_KEY=
ZAI_API_KEY=
OLLAMA_API_KEY=
OPENCODE_ZEN_API_KEY=
KILO_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
XKIRO_API_KEY=

# Host ports. Compose binds them to 127.0.0.1 by default.
UNIFIED_PORT=3260

# Optional bearer token for the unified API and gateway.
GATEWAY_API_KEY=

# Encrypts the credential registry session/credentials.enc.
# Leave empty: `bun run account init` keeps it in the system keyring instead of this file.
# Set it only where no keyring exists (Docker, CI).
ACCOUNTS_SECRET=

# Fallback order for model=auto (comma-separated). Empty = built automatically:
# web chats first, then discovered NVIDIA models, fastest measured first.
AUTO_MODELS=
# Skip an auto route that sends nothing within this time (0 disables).
AUTO_FIRST_CHUNK_TIMEOUT_MS=60000
# Minimum pause between two messages to the same web chat account, in ms
WEB_CHAT_MIN_INTERVAL_MS=10000
# How often provider model lists are refreshed (0 disables).
MODEL_REFRESH_MINUTES=360
